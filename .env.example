# Placar ao vivo (opcional).
#
# Sem estas variáveis o site funciona normalmente, só que cada aparelho fica com
# a própria cópia guardada no navegador. Com elas, o campeonato passa a viver no
# Supabase e todo mundo vê os resultados na hora.
#
# A chave publicável é pública por natureza: ela vai no bundle do site e só tem
# permissão de leitura. Gravar exige o PIN do organizador, conferido dentro do
# banco (ver supabase/schema.sql).
#
# Copie este arquivo para `.env` no desenvolvimento e cadastre as mesmas
# variáveis em Settings → Environment Variables no painel da Vercel.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Em Settings → API Keys, use a chave "publishable" (sb_publishable_…).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave

# Projetos antigos ainda podem usar a chave anônima legada, também aceita:
# VITE_SUPABASE_ANON_KEY=sua-chave-anonima

# Opcional: permite manter mais de um campeonato no mesmo projeto.
# VITE_CAMPEONATO_ID=unidos-acamp
